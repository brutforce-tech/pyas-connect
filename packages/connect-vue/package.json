{
  "name": "@pyas/connect-vue",
  "version": "2.0.0-alpha.0",
  "description": "PyasConnect for Vue 3: the <pyas-connect> element with Vue props and events.",
  "keywords": [
    "pyas",
    "pyas-connect",
    "vue",
    "vue3",
    "oauth",
    "web-components",
    "stencil",
    "plugin",
    "calendar-integration",
    "outlook api integration",
    "google calendar integration",
    "microsoft graph api",
    "google api"
  ],
  "author": "Pyas Team <support@pyas.io>",
  "homepage": "https://github.com/brutforce-tech/pyas-connect",
  "license": "MIT",
  "type": "module",
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./index.css": "./dist/index.css"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vue-tsc -p tsconfig.app.json --noEmit && vite build",
    "test": "vitest run",
    "type-check": "vue-tsc -p tsconfig.app.json --noEmit"
  },
  "peerDependencies": {
    "vue": "^3.0.0"
  },
  "dependencies": {
    "@pyas/connect": "2.0.0-alpha.0"
  },
  "devDependencies": {
    "@tsconfig/node22": "^22.0.1",
    "@types/jsdom": "^21.1.7",
    "@types/node": "^22.14.0",
    "@vue/test-utils": "^2.4.6",
    "@vue/tsconfig": "^0.7.0",
    "jsdom": "^26.0.0",
    "typescript": "~5.8.0",
    "vite": "^6.2.4",
    "vite-plugin-dts": "^4.5.4",
    "vitest": "^3.1.1",
    "vue": "^3.5.13",
    "vue-tsc": "^2.2.8"
  }
}
